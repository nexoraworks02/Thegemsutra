# Isolated M2 commerce TEST backend (local only).
# Do not edit by hand: `npm run m2test -- init` creates apps/backend/.env.m2test from this
# template with freshly generated secrets. That file is git-ignored; never commit it.
#
# EVERY key in apps/backend/.env must be defined here too: Medusa always loads .env and
# fills in any missing key from it, which would mix the original environment into the
# test backend. The launcher refuses to start if a key is missing.

STORE_CORS=http://localhost:3001,http://127.0.0.1:3001
ADMIN_CORS=http://localhost:9001,http://127.0.0.1:9001
AUTH_CORS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:9001,http://127.0.0.1:9001
JWT_SECRET=__GENERATED__
COOKIE_SECRET=__GENERATED__

# Separate embedded PostgreSQL instance: port 5433, data folder apps/backend/.pgdata-m2test
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/jemsutra_m2test
DB_NAME=jemsutra_m2test

# Test-only admin identity (reserved .test domain). No admin user is created in M2.1.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=__GENERATED__

# Shared local image service (read-only renders). A test-only internal key means the image
# service refuses this backend's internal calls; the seed then skips the artwork check.
IMAGE_SERVICE_URL=http://localhost:4100
INTERNAL_API_KEY=__GENERATED__

# The TEST storefront (port 3001) - never the normal one
STORE_URL=http://127.0.0.1:3001
REVALIDATE_SECRET=__GENERATED__

# Separate development email outbox (git-ignored); emails are files, never sent
OUTBOX_DIR=.outbox-m2test

NODE_ENV=development
HMR_BIND_HOST=127.0.0.1
