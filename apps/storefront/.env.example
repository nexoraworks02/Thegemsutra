# Where the image render service runs (services/image)
NEXT_PUBLIC_IMAGE_URL=http://localhost:4100

# Medusa backend (apps/backend) and its publishable API key
# (Admin dashboard -> Settings -> Publishable API Keys, or printed by `npm run seed`)
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Same value as REVALIDATE_SECRET in apps/backend/.env (lets the admin refresh designs instantly)
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Try-on prototype (/dev/try-on): always on in `next dev`; set to true to enable in a production build.
# ENABLE_TRYON_DEMO=true
# Optional: load the pose model from another location (default: self-hosted /mediapipe/models/...).
# NEXT_PUBLIC_POSE_MODEL_URL=/mediapipe/models/pose_landmarker_lite.task

# DEMO catalog (/demo/catalog): always on in `next dev`; set to true to include it in a production build.
# Never set this for the live store. Needs DEMO_CATALOG_DIR on the image service.
# ENABLE_DEMO_CATALOG=true
