# Isolated M2 commerce TEST storefront (local only, port 3001).
# `npm run m2test -- init` creates apps/storefront/.env.m2test from this template;
# `npm run m2test -- seed` fills in the test database's publishable key. Git-ignored.

NEXT_PUBLIC_MEDUSA_URL=http://127.0.0.1:9001
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=__FROM_TEST_SEED__
NEXT_PUBLIC_IMAGE_URL=http://localhost:4100
REVALIDATE_SECRET=__SAME_AS_TEST_BACKEND__
NEXT_DIST_DIR=.next-m2test
