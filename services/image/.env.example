# Backend that stores the designs, and the shared internal key (same as apps/backend/.env)
MEDUSA_URL=http://localhost:9000
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Development only: serve the try-on demo necklace (JSN900). Leave unset in production.
# ENABLE_TRYON_DEMO=true

# Development only: serve the DEMO catalog generated by `npm run catalog:import`
# (temporary test images; never enabled in production unless ENABLE_DEMO_CATALOG=true).
# DEMO_CATALOG_DIR=.demo-catalog
