{
  "name": "@jemsutra/image-service",
  "version": "0.1.0",
  "private": true,
  "description": "Renders personalised product images from layers (metal + stones + engraving)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "layers": "tsx scripts/generate-demo-layers.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/great-vibes": "^5.1.0",
    "@fontsource/montserrat": "^5.1.0",
    "@fontsource/playfair-display": "^5.1.0",
    "@hono/node-server": "^1.13.7",
    "@jemsutra/design-engine": "0.1.0",
    "hono": "^4.6.14",
    "opentype.js": "^1.3.4",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/opentype.js": "^1.3.8",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
