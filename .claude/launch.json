{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storefront",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@jemsutra/storefront"
      ],
      "port": 3000
    },
    {
      "name": "image-service",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "-w",
        "@jemsutra/image-service"
      ],
      "port": 4100
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/backend"
      ],
      "port": 9000
    }
  ]
}
